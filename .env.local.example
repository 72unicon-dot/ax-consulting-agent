# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored so real secrets never end up in git history.

# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service role key — required for notification fan-out and first-login provisioning.
# Never expose to the client. Only used from server routes.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Anthropic API key with access to claude-opus-5.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Public base URL used to build magic-link redirects.
# In prod, set this to your deployed origin (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
